.config/ghostty/themes/vesper-shell-light
.local/share/vicinae/themes/zinc.toml

# matugen, removed entirely. It derived a Material You palette from the
# wallpaper, which is the opposite of pinning one scheme — and every file it
# generated was already dead: nvim never read its base46, Colloid's gtk.css
# never imported its colors.css, hypr loads only lua_modules/, vesktop had a
# different theme enabled, nothing called slurp.sh, and rofi, alacritty and
# ghostty all select themes of their own. zathura and yazi were the only live
# consumers, and they are pinned to Caffeine now.
#
# Every entry below can be dropped once each machine has applied once.
.config/matugen
.config/ghostty/themes/matugen
.config/kitty/slurp.sh
.config/gtk-3.0/colors.css
.config/gtk-4.0/colors.css
.config/vesktop/themes/axmat.theme.css
.config/alacritty/colors.toml
.cache/wal

# Only colors.conf here was matugen's. The other four modules/*.conf are
# hand-written, and belong to the .conf config that predates the Lua one —
# `hyprctl systeminfo` reports `configProvider: lua`, so hyprland.conf,
# shared.conf and modules/ are all dead, but pruning that is its own cleanup
# and not matugen's doing.
.config/hypr/modules/colors.conf

# Manual captive-portal toggle, replaced by the NetworkManager dispatcher hook
# that run_after_configure-dns.sh installs.
.local/bin/portal

# graphite replaced Caffeine. rofi and gtklock had no callers (vicinae and
# hyprlock do their jobs); the Colloid GTK theme, its orange icons and cursors
# gave way to adw-gtk3 + graphite css and grey icons, and Bibata is the cursor.
.config/rofi
.local/share/rofi
.config/gtklock
.local/share/themes/Colloid-Orange-*
.local/share/icons/Colloid-Orange*
.local/share/icons/Colloid-cursors
.local/share/icons/Colloid-dark-cursors
.config/gtk-4.0/colloid-*.css
.config/gtk-4.0/assets
.local/share/vicinae/themes/caffeine.toml
.config/ghostty/brutal.css
# vicinae has read settings.json, not vicinae.json, since v0.17.
.config/vicinae/vicinae.json
.config/ghostty/graphite.css
