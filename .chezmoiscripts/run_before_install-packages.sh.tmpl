#!/bin/bash
# Builds and installs this machine's dots-* packages from pkg/. Each package's
# pkgver is its directory's content hash, so an unchanged package is skipped
# without a password prompt, and only a changed one is reinstalled and fires
# its hook. A before_ script, so set-theme and the qt5ct/qt6ct modify_ scripts
# find their packages in the same apply.
{{- $m := index .machines .chezmoi.hostname }}
set -euo pipefail

want=(dots-desktop dots-dns dots-oom dots-power
      {{ if eq $m.wm "sway" }}dots-sway{{ else }}dots-hyprland{{ end }}
      {{ if $m.is_laptop }}dots-power-laptop{{ else }}dots-power-desktop{{ end }})

src="$CHEZMOI_SOURCE_DIR/pkg"
stage="$(mktemp -d)"
trap 'rm -rf "$stage"' EXIT

built=() deps=()
for p in "${want[@]}"; do
    # C collation, or the file order and so the hash would follow the locale.
    hash="$(cd "$src/$p" && find . -type f -print0 | LC_ALL=C sort -z | xargs -0 sha256sum | sha256sum | cut -c1-16)"
    [[ "$(pacman -Q "$p" 2>/dev/null)" == "$p $hash-"* ]] && continue
    # Built from a copy: makepkg leaves src/, pkg/ and the package behind.
    cp -r "$src/$p" "$stage/"
    (cd "$stage/$p" && DOTS_PKGVER="$hash" makepkg --nodeps --noconfirm)
    built+=("$stage/$p"/*.pkg.tar.zst)
    mapfile -t -O "${#deps[@]}" deps < <(cd "$stage/$p" && DOTS_PKGVER="$hash" makepkg --printsrcinfo |
                                          sed -n 's/^\tdepends = //p')
done
((${#built[@]})) || exit 0

# pacman -U cannot fetch AUR dependencies; yay can.
((${#deps[@]})) && yay -S --needed --noconfirm "${deps[@]}"
sudo pacman -U --noconfirm "${built[@]}"
# Re-marked even when installed explicitly before, so a name dropped from a
# PKGBUILD shows up in `pacman -Qdt` instead of staying installed unnoticed.
((${#deps[@]})) && sudo pacman -D --asdeps "${deps[@]}" >/dev/null
exit 0
