#!/bin/sh
# Kvantum's theme, in step with the GTK colour scheme: graphite (light) or
# graphiteDark, both built by kvantum.py. A modify_ script because theme-toggle
# rewrites this file, so its contents depend on gsettings at apply time.
#
# Anything but an explicit light scheme is dark, as in the set-theme script,
# since a fresh profile reports 'default'.
case "$(gsettings get org.gnome.desktop.interface color-scheme 2>/dev/null)" in
    *prefer-light*) theme=graphite ;;
    *) theme=graphiteDark ;;
esac
printf '[General]\ntheme=%s\n' "$theme"
