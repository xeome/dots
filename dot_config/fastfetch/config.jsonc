{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // Colours are ANSI names, not hex, so they follow the terminal's Caffeine
    // ramp (~/.config/ghostty/themes/caffeine). light_yellow is the accent.
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/cat",
        "color": { "1": "light_yellow" },
        "padding": { "top": 1, "right": 3 }
    },

    "display": {
        "separator": "  ",
        // Wider than the longest key needs: a key that overruns the column
        // loses its separator, and a Nerd glyph is two cells wide in some fonts.
        "key": { "width": 12 },
        "color": { "separator": "light_black" },
        "bar": {
            "char": { "elapsed": "━", "total": "─" },
            "width": 12,
            // The unfilled run is dim so it does not outshout the filled one.
            "border": { "left": "", "right": "" },
            "color": { "total": "light_black" }
        },
        // type 2 = bar only, no number.
        "percent": {
            "type": 2,
            "color": { "green": "green", "yellow": "yellow", "red": "red" }
        }
    },

    "modules": [
        // No `format` on the title: a custom one loses this per-part colouring.
        {
            "type": "title",
            "color": { "user": "light_yellow", "at": "light_black", "host": "light_yellow" }
        },
        {
            "type": "custom",
            "format": "────────────────────────────────────────────",
            "outputColor": "light_black"
        },

        { "type": "os",       "key": " os",     "keyColor": "light_yellow" },
        { "type": "kernel",   "key": " kernel", "keyColor": "light_yellow", "format": "{release}" },
        { "type": "uptime",   "key": " uptime", "keyColor": "light_yellow" },
        { "type": "packages", "key": " pkgs",   "keyColor": "light_yellow", "format": "{all}" },
        { "type": "shell",    "key": " shell",  "keyColor": "light_yellow" },

        "break",

        { "type": "wm",       "key": " wm",    "keyColor": "green" },
        { "type": "terminal", "key": " term",  "keyColor": "green" },
        { "type": "display",  "key": " disp",  "keyColor": "green", "format": "{width}x{height} @ {refresh-rate}Hz" },
        { "type": "custom",   "key": " theme", "keyColor": "green", "format": "graphite" },

        "break",

        { "type": "cpu",    "key": " cpu",  "keyColor": "cyan", "format": "{name}" },
        { "type": "gpu",    "key": " gpu",  "keyColor": "cyan", "format": "{name}" },
        { "type": "memory", "key": " mem",  "keyColor": "cyan" },
        { "type": "disk",   "key": " disk", "keyColor": "cyan", "folders": "/" },

        "break",

        { "type": "colors", "paddingLeft": 2, "symbol": "circle" }
    ]
}
