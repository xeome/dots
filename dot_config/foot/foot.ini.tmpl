{{- $m := index .machines .chezmoi.hostname -}}
# Caffeine — https://github.com/crynta/terax-ai src/modules/theme/themes/caffeine.ts
#
# Mirrors ~/.config/ghostty/themes/caffeine{,-light} and alacritty's
# caffeine.toml; quickshell's Theme.qml carries the same scheme for the shell.
# A change here wants the same change there.

[main]
font=JetBrainsMono Nerd Font:style=Medium:size={{ mulf 10.0 $m.text_scale }}
font-bold=JetBrainsMono Nerd Font:style=Bold:size={{ mulf 10.0 $m.text_scale }}
font-italic=JetBrainsMono Nerd Font:style=Medium Italic:size={{ mulf 10.0 $m.text_scale }}
font-bold-italic=JetBrainsMono Nerd Font:style=Bold Italic:size={{ mulf 10.0 $m.text_scale }}
pad=15x15
term=xterm-256color

# foot 1.28 replaced the single [colors] section with this dark/light pair. The
# old config still had [colors] and so was silently *rejected wholesale* —
# which is why foot was the one terminal here wearing neither the scheme nor
# these fonts. `foot --check-config` catches that; run it after editing.
#
# foot cannot follow the desktop colour scheme itself, so theme-toggle signals
# it (SIGUSR1 dark / SIGUSR2 light) alongside flipping gsettings for ghostty.
initial-color-theme=dark

[colors-dark]
# Opaque. Was 0.55, which made every contrast ratio a function of whatever
# window happened to be behind it.
alpha=1.0

background=111111
foreground=eeeeee

# Caffeine's `primary`, its cursor and ring colour. foot takes `text bg`.
cursor=081a1b ffe0c2

# `rgba(255,224,194,0.20)` flattened over the background — the primary as a
# 20% wash, which is what the scheme specifies, not a solid accent fill.
selection-foreground=eeeeee
selection-background=413a34

# Caffeine's `terminal.ansi`, verbatim. regular0 is the scheme's `secondary`
# (#393028, espresso) rather than a true black: the background is already
# near-black, so a black "black" would be invisible.
regular0=393028
regular1=e06c75
regular2=b5c98f
regular3=ffd9a0
regular4=8fb0d9
regular5=cba6c9
regular6=88c0c8
regular7=d8cbb8
bright0=5c5046
bright1=ff8a93
bright2=c9dba8
bright3=ffe6c4
bright4=a9c3e0
bright5=ddc0db
bright6=a4d4da
bright7=f0e6d6

[colors-light]
alpha=1.0

background=f9f9f9
foreground=202020

cursor=ffffff 644a40

selection-foreground=202020
selection-background=e1dddb

regular0=3a322a
regular1=c0392b
regular2=5a7d3c
regular3=a9762a
regular4=3a6ea5
regular5=9a4f8a
regular6=2a8589
regular7=c8c0b4
bright0=6b6258
bright1=d04a3a
bright2=6a9048
bright3=c08a3a
bright4=4a7eb5
bright5=aa5f9a
bright6=3a989c
bright7=202020

[cursor]
style=block

[mouse]
hide-when-typing=yes

[key-bindings]
font-increase=Control+Shift+plus
font-decrease=Control+Shift+underscore
font-reset=Control+0
