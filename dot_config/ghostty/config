# --- Environment ---
shell-integration-features = ssh-env

# --- Fonts ---
font-size = 10

font-family = JetBrainsMono Nerd Font
font-style = Bold

font-family-bold = Monaspace Neon
font-style-bold = ExtraBold

font-family-italic = Monaspace Neon
font-style-italic = Italic

font-family-bold-italic = Monaspace Neon
font-style-bold-italic = Bold Italic

# --- Window ---
background-opacity = 0.85
window-padding-x = 15
window-padding-y = 15

# Every colour lives in themes/vesper-shell — Vesper warmed to match
# quickshell's Theme.qml. Nothing colour-related belongs in this file: anything
# set here would silently override the theme rather than sit alongside it.
theme = vesper-shell

keybind = ctrl+shift+plus=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1
