# --- Environment ---
shell-integration-features = ssh-env

# --- Fonts ---
font-size = 10

# Fixed at 10pt rather than scaled by text_scale, which read too large here.
font-family = JetBrainsMono Nerd Font
font-style = Medium
font-style-bold = Bold
font-style-italic = Medium Italic
font-style-bold-italic = Bold Italic

# --- Window ---
# Opaque (background-opacity defaults to 1), so contrast does not depend on
# the wallpaper.
window-padding-x = 15
window-padding-y = 15

# Every colour lives in themes/caffeine{,-light}; one set here would override
# the theme. The pair follows the desktop colour scheme, which theme-toggle
# flips through gsettings.
theme = light:caffeine-light,dark:caffeine

# --- Chrome ---
# The compositor tiles, so the headerbar's window buttons do nothing. Without
# it the tab bar shows only from two tabs; new tab and the menu move to the
# right-click menu and keybinds.
gtk-titlebar = false
gtk-wide-tabs = false
window-title-font-family = Inter

keybind = ctrl+shift+plus=increase_font_size:1
keybind = ctrl+shift+minus=decrease_font_size:1
