# Caffeine — https://github.com/crynta/terax-ai src/modules/theme/themes/caffeine.ts
#
# Managed by chezmoi: edit dot_config/ghostty/exact_themes/caffeine
#
# Colours only, like ghostty's built-in themes; everything else stays in the
# config. Mirrors ~/.config/alacritty/caffeine.toml, ~/.config/foot/foot.ini
# and quickshell's Theme.qml, so a change here wants the same change there.

# --- ANSI 16 -------------------------------------------------------------
# Caffeine's `terminal.ansi`, verbatim. Slot 0 is the scheme's `secondary`
# (#393028, espresso) rather than a true black: the background is already
# near-black, so a black "black" would be invisible.
palette = 0=#393028
palette = 1=#e06c75
palette = 2=#b5c98f
palette = 3=#ffd9a0
palette = 4=#8fb0d9
palette = 5=#cba6c9
palette = 6=#88c0c8
palette = 7=#d8cbb8
palette = 8=#5c5046
palette = 9=#ff8a93
palette = 10=#c9dba8
palette = 11=#ffe6c4
palette = 12=#a9c3e0
palette = 13=#ddc0db
palette = 14=#a4d4da
palette = 15=#f0e6d6

# --- Surfaces ------------------------------------------------------------
# The background is graphite's panel (quickshell's Theme.panel); the
# foreground is Caffeine's.
background = #0e0e10
foreground = #eeeeee

# Caffeine's `primary`, its cursor and ring colour.
cursor-color = #ffe0c2
cursor-text = #081a1b

# Caffeine's selection is the primary as a 20% wash. Ghostty has no alpha
# here, so the wash is flattened to a solid colour.
selection-background = #413a34
selection-foreground = #eeeeee
