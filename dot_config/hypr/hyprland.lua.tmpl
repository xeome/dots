-- =============================================================================
-- HYPRLAND MAIN CONFIGURATION (LUA)
-- =============================================================================
-- This is the main entry point for Hyprland configuration.
--
-- Device profiles are driven by chezmoi data in .chezmoidata.toml.
-- To add a new machine: add an entry under [machines.<hostname>] in that file.
-- =============================================================================
{{- $m := index .machines .chezmoi.hostname }}

-- =============================================================================
-- USER PREFERENCES
-- =============================================================================
-- Terminal launch command (bound to SUPER + Return in lua_modules/keybinds.lua).
-- Change this to use a different terminal, e.g. "alacritty" or "kitty".
terminal = {{ $m.terminal | quote }}

-- =============================================================================
-- ENVIRONMENT VARIABLES
-- =============================================================================

hl.env("XDG_SESSION_TYPE", "wayland")
hl.env("SDL_VIDEODRIVER", "wayland")
hl.env("QT_QPA_PLATFORM", "wayland;xcb")
hl.env("QT_AUTO_SCREEN_SCALE_FACTOR", "1")
hl.env("QT_WAYLAND_DISABLE_WINDOWDECORATION", "1")
hl.env("SSH_AUTH_SOCK", "{{ .chezmoi.homeDir }}/.bitwarden-ssh-agent.sock")
hl.env("HYPRCURSOR_THEME", "Bibata-Modern-Classic")
hl.env("HYPRCURSOR_SIZE", "24")
hl.env("XCURSOR_THEME", "Bibata-Modern-Classic")
hl.env("XCURSOR_SIZE", "24")
hl.env("OBSIDIAN_USE_WAYLAND", "1")

-- =============================================================================
-- MONITOR SETUP
-- =============================================================================
{{ range $m.monitors }}
hl.monitor({ output = {{ .output | quote }}, mode = {{ .mode | quote }}, position = {{ .position | quote }}, scale = {{ .scale }} })
{{- end }}

-- =============================================================================
-- WORKSPACE ASSIGNMENTS
-- =============================================================================
{{ range $m.workspaces }}
hl.workspace_rule({ workspace = {{ .workspace | quote }}, monitor = {{ .monitor | quote }} })
{{- end }}

-- =============================================================================
-- INPUT CONFIGURATION
-- =============================================================================

hl.config({
  input = {
    kb_layout = "tr",
    numlock_by_default = {{ $m.numlock }},
    kb_options = "grp:win_space_toggle",
    touchpad = {
      disable_while_typing = true,
      tap_to_click = true,
      natural_scroll = {{ $m.natural_scroll }},
      middle_button_emulation = true,
    },
  },
})

-- =============================================================================
-- MOUSE
-- =============================================================================
-- ponytail: the wireless dongle enumerates two pointer interfaces, so both get
-- the same settings. Device blocks for absent devices are ignored, so this is
-- unconditional — no per-machine flag needed.
for _, name in ipairs({
  "razer-razer-basilisk-v3-x-hyperspeed",
  "razer-razer-basilisk-v3-x-hyperspeed-2",
}) do
  hl.device({
    name = name,
    natural_scroll = false,
    accel_profile = "flat",
    -- flat profile speed is a 1+x multiplier: 0.4 -> 1.4x, twice the old -0.3.
    sensitivity = 0.4,
    scroll_factor = 0.8,
  })
end

-- =============================================================================
-- DEVICE-SPECIFIC KEYBINDS
-- =============================================================================

hl.bind("SUPER + d", hl.dsp.exec_cmd({{ $m.discord_cmd | quote }}))
hl.bind("Print", hl.dsp.exec_cmd("~/.config/hypr/bin/satty-screenshot.sh"))
{{ if $m.is_laptop }}
-- Lock the screen when the laptop lid closes
hl.bind("switch:on:Lid Switch", hl.dsp.exec_cmd("hyprlock"), { locked = true })
{{ end }}

-- =============================================================================
-- SHARED MODULES
-- =============================================================================

require("lua_modules.colors")
require("lua_modules.settings")
require("lua_modules.keybinds")
require("lua_modules.rules")
require("lua_modules.startup")

-- =============================================================================
-- USER LOCAL OVERRIDES (OPTIONAL)
-- =============================================================================

pcall(dofile, "user.local.lua")
