-- Hyprland entry point. Per-machine values come from [machines.<hostname>] in
-- .chezmoidata.toml; the shared config is in lua_modules/.
{{- $m := index .machines .chezmoi.hostname }}

-- =============================================================================
-- USER PREFERENCES
-- =============================================================================
-- Globals read by lua_modules/keybinds.lua and startup.lua.
terminal = {{ $m.terminal | quote }}

-- Run a heavy app in its own scope. Otherwise it shares Hyprland's session
-- scope, and systemd-oomd killing that cgroup takes the compositor down too.
function app(cmd)
  return "systemd-run --user --scope --quiet -- " .. cmd
end

-- =============================================================================
-- ENVIRONMENT VARIABLES
-- =============================================================================

hl.env("XDG_SESSION_TYPE", "wayland")
hl.env("SDL_VIDEODRIVER", "wayland")
hl.env("QT_QPA_PLATFORM", "wayland;xcb")
hl.env("QT_AUTO_SCREEN_SCALE_FACTOR", "1")
hl.env("QT_WAYLAND_DISABLE_WINDOWDECORATION", "1")
hl.env("SSH_AUTH_SOCK", "{{ .chezmoi.homeDir }}/.bitwarden-ssh-agent.sock")
hl.env("HYPRCURSOR_THEME", "Bibata-Modern-Classic")
hl.env("HYPRCURSOR_SIZE", "24")
hl.env("XCURSOR_THEME", "Bibata-Modern-Classic")
hl.env("XCURSOR_SIZE", "24")
hl.env("OBSIDIAN_USE_WAYLAND", "1")
-- Read by quickshell's Theme.qml; see text_scale in .chezmoidata.toml.
hl.env("TEXT_SCALE", "{{ $m.text_scale }}")

-- =============================================================================
-- MONITOR SETUP
-- =============================================================================
{{ range $m.monitors }}
hl.monitor({ output = {{ .output | quote }}, mode = {{ .mode | quote }}, position = {{ .position | quote }}, scale = {{ .scale }} })
{{- end }}

-- =============================================================================
-- WORKSPACE ASSIGNMENTS
-- =============================================================================
{{ range $m.workspaces }}
hl.workspace_rule({ workspace = {{ .workspace | quote }}, monitor = {{ .monitor | quote }} })
{{- end }}

-- =============================================================================
-- INPUT CONFIGURATION
-- =============================================================================

hl.config({
  input = {
    kb_layout = "tr",
    numlock_by_default = {{ $m.numlock }},
    kb_options = "grp:win_space_toggle",
    touchpad = {
      disable_while_typing = true,
      tap_to_click = true,
      natural_scroll = {{ $m.natural_scroll }},
      middle_button_emulation = true,
    },
  },
})

-- =============================================================================
-- MOUSE
-- =============================================================================
-- ponytail: device names are hardcoded, not per-machine; blocks for absent
-- devices are ignored. The wireless dongle exposes two pointer interfaces.
for _, name in ipairs({
  "razer-razer-basilisk-v3-x-hyperspeed",
  "razer-razer-basilisk-v3-x-hyperspeed-2",
}) do
  hl.device({
    name = name,
    natural_scroll = false,
    accel_profile = "flat",
    -- With the flat profile, speed is 1 + sensitivity: 1.4x.
    sensitivity = 0.4,
    scroll_factor = 0.8,
  })
end

-- =============================================================================
-- DEVICE-SPECIFIC KEYBINDS
-- =============================================================================

hl.bind("SUPER + d", hl.dsp.exec_cmd(app({{ $m.discord_cmd | quote }})))
hl.bind("Print", hl.dsp.exec_cmd("qs -c xeome ipc call shot open"))
{{ if $m.is_laptop }}
hl.bind("switch:on:Lid Switch", hl.dsp.exec_cmd("hyprlock"), { locked = true })
{{ end }}

-- =============================================================================
-- SHARED MODULES
-- =============================================================================

require("lua_modules.settings")
require("lua_modules.keybinds")
require("lua_modules.rules")
require("lua_modules.startup")

-- =============================================================================
-- OPTIONAL OVERRIDES
-- =============================================================================
-- Absolute path: dofile() resolves against Hyprland's CWD, not this directory.

pcall(dofile, os.getenv("HOME") .. "/.config/hypr/user.local.lua")
