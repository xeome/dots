# Lock screen for every machine, sway ones included. Managed by chezmoi: edit
# dot_config/hypr/hyprlock.conf.tmpl.

# $lock_output holds the input field, player and system info.
{{- $m := index .machines .chezmoi.hostname }}
$lock_output = {{ $m.lock_output }}

# =============================================================================
# GENERAL
# =============================================================================
general {
    hide_cursor = true
    ignore_empty_input = true
    text_trim = true
}

# =============================================================================
# BACKGROUND
# =============================================================================
# Baked by quickshell/grain.py, because hyprlock can't draw a gradient. No
# screenshot or blur: the lock screen is its own surface.
background {
    path = ~/.config/hypr/graphite-lock.png
    color = rgba(10, 10, 12, 1)
}

# =============================================================================
# CLOCK
# =============================================================================
# Widgets on every monitor anchor to the centre, so the stack keeps its spacing
# at any height. Offsets are tuned at 1080p.
#
# The clock is the desk's Doto (Desk.qml's Num) with round dots. hyprlock hands
# font_family to pango_font_description_from_string, which reads the axes
# after the @.

# Hours
label {
    text = cmd[update:1000] echo "$(date +'%H')"
    color = rgba(247, 248, 248, 1)
    font_size = 150
    font_family = Doto @ROND=100,wght=900
    position = 0, 168
    halign = center
    valign = center
}

# Minutes
label {
    text = cmd[update:1000] echo "$(date +'%M')"
    color = rgba(247, 248, 248, 1)
    font_size = 150
    font_family = Doto @ROND=100,wght=900
    position = 0, -2
    halign = center
    valign = center
}

# Date
label {
    text = cmd[update:1000] echo "$(date +'%d %b %A')"
    color = rgba(138, 143, 152, 1)
    font_size = 14
    font_family = Inter Medium
    position = 0, -130
    halign = center
    valign = center
}

# =============================================================================
# WEATHER
# =============================================================================
label {
    text = cmd[update:1000] echo "$(bash ~/.config/hypr/bin/location.sh) $(bash ~/.config/hypr/bin/weather.sh)"
    color = rgba(138, 143, 152, 1)
    font_size = 10
    font_family = Inter Medium
    position = 0, 465
    halign = center
    valign = center
}

# =============================================================================
# MEDIA PLAYER
# =============================================================================

# Album art
image {
    monitor = $lock_output
    path = ~/.cache/playerctlock-art/latest.png
    size = 60
    rounding = 6
    border_size = 1
    border_color = rgba(255, 255, 255, 0.08)
    rotate = 0
    reload_time = 1
    reload_cmd = ~/.config/hypr/bin/playerctlock.sh --arturl
    position = -150, -300
    halign = center
    valign = center
}

# Track title
label {
    monitor = $lock_output
    text = cmd[update:1000] echo "$(~/.config/hypr/bin/playerctlock.sh --title)"
    color = rgba(247, 248, 248, 1)
    font_size = 12
    font_family = Inter SemiBold
    position = 880, -290
    halign = left
    valign = center
}

# Track length
label {
    monitor = $lock_output
    text = cmd[update:1000] echo "$(~/.config/hypr/bin/playerctlock.sh --length)"
    color = rgba(138, 143, 152, 1)
    font_size = 11
    font_family = Inter
    position = -730, -310
    halign = right
    valign = center
}

# Playback status
label {
    monitor = $lock_output
    text = cmd[update:1000] echo "$(~/.config/hypr/bin/playerctlock.sh --status)"
    color = rgba(230, 231, 234, 1)
    font_size = 14
    font_family = Inter
    position = -740, -290
    halign = right
    valign = center
}

# Player source
label {
    monitor = $lock_output
    text = cmd[update:1000] echo "$(~/.config/hypr/bin/playerctlock.sh --source)"
    color = rgba(138, 143, 152, 1)
    font_size = 10
    font_family = Inter
    position = -740, -330
    halign = right
    valign = center
}

# Album name
label {
    monitor = $lock_output
    text = cmd[update:1000] echo "$(~/.config/hypr/bin/playerctlock.sh --album)"
    color = rgba(138, 143, 152, 1)
    font_size = 10
    font_family = Inter
    position = 880, -330
    halign = left
    valign = center
}

# Artist name
label {
    monitor = $lock_output
    text = cmd[update:1000] echo "$(~/.config/hypr/bin/playerctlock.sh --artist)"
    color = rgba(230, 231, 234, 1)
    font_size = 10
    font_family = Inter Medium
    position = 880, -310
    halign = left
    valign = center
}

# =============================================================================
# INPUT
# =============================================================================
# A dark ring one pixel outside the field's own translucent outline.
shape {
    monitor = $lock_output
    size = 252, 62
    color = rgba(0, 0, 0, 0)
    rounding = 11
    border_size = 1
    border_color = rgba(0, 0, 0, 0.3)
    position = 0, -470
    halign = center
    valign = center
    zindex = 9
}

input-field {
    monitor = $lock_output
    size = 250, 60
    rounding = 10
    outline_thickness = 1
    outer_color = rgba(255, 255, 255, 0.08)
    # Colour only for meaning: fail and caps lock. Checking just brightens.
    check_color = rgba(255, 255, 255, 0.5)
    fail_color = rgba(226, 113, 90, 1)
    capslock_color = rgba(229, 174, 82, 1)
    dots_size = 0.1
    dots_spacing = 1
    dots_center = true
    inner_color = rgba(21, 22, 24, 1)
    font_color = rgba(230, 231, 234, 1)
    fade_on_empty = false
    font_family = Inter
    placeholder_text = <span foreground="##8a8f98"> $USER</span>
    hide_input = false
    position = 0, -470
    halign = center
    valign = center
    zindex = 10
}

# =============================================================================
# SYSTEM INFO
# =============================================================================
label {
    monitor = $lock_output
    text = cmd[update:1000] echo -e "$(~/.config/hypr/bin/infonlock.sh)"
    color = rgba(138, 143, 152, 1)
    font_size = 12
    font_family = Inter Medium
    position = -20, -510
    halign = right
    valign = center
}
