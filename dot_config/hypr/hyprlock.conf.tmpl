# =============================================================================
# HYPRLOCK CONFIGURATION
# Managed by chezmoi — edit: ~/.local/share/chezmoi/dot_config/hypr/hyprlock.conf.tmpl
# =============================================================================

# $scr2: monitor for device-specific widgets (input field, player, info)
{{- $m := index .machines .chezmoi.hostname }}
$scr2 = {{ $m.secondary_monitor }}

# =============================================================================
# GENERAL
# =============================================================================
general {
    hide_cursor = true
    ignore_empty_input = true
    text_trim = true
}

# =============================================================================
# BACKGROUND
# =============================================================================
# graphite's ground with its corner glow and grain, baked by
# quickshell/grain.py; hyprlock can't draw a gradient. No screenshot and no
# blur: the lock screen is a surface of its own, not a frosted desktop.
background {
    path = ~/.config/hypr/graphite-lock.png
    color = rgba(10, 10, 12, 1)
}

# =============================================================================
# CLOCK
# =============================================================================

# Hours
label {
    text = cmd[update:1000] echo "$(date +'%H')"
    color = rgba(247, 248, 248, 1)
    font_size = 150
    font_family = Inter SemiBold
    position = 0, -250
    halign = center
    valign = top
}

# Minutes
label {
    text = cmd[update:1000] echo "$(date +'%M')"
    color = rgba(247, 248, 248, 1)
    font_size = 150
    font_family = Inter SemiBold
    position = 0, -420
    halign = center
    valign = top
}

# Date
label {
    text = cmd[update:1000] echo "$(date +'%d %b %A')"
    color = rgba(138, 143, 152, 1)
    font_size = 14
    font_family = Inter Medium
    position = 0, -130
    halign = center
    valign = center
}

# =============================================================================
# WEATHER
# =============================================================================
label {
    text = cmd[update:1000] echo "$(bash ~/.config/hypr/bin/location.sh) $(bash ~/.config/hypr/bin/weather.sh)"
    color = rgba(138, 143, 152, 1)
    font_size = 10
    font_family = Inter Medium
    position = 0, 465
    halign = center
    valign = center
}

# =============================================================================
# MEDIA PLAYER
# =============================================================================

# Album art
image {
    monitor = $scr2
    path = ~/.cache/playerctlock-art/latest.png
    size = 60
    rounding = 6
    border_size = 1
    border_color = rgba(255, 255, 255, 0.08)
    rotate = 0
    reload_time = 1
    reload_cmd = ~/.config/hypr/bin/playerctlock.sh --arturl
    position = -150, -300
    halign = center
    valign = center
}

# Track title
label {
    monitor = $scr2
    text = cmd[update:1000] echo "$(~/.config/hypr/bin/playerctlock.sh --title)"
    color = rgba(247, 248, 248, 1)
    font_size = 12
    font_family = Inter SemiBold
    position = 880, -290
    halign = left
    valign = center
}

# Track length
label {
    monitor = $scr2
    text = cmd[update:1000] echo "$(~/.config/hypr/bin/playerctlock.sh --length)"
    color = rgba(138, 143, 152, 1)
    font_size = 11
    font_family = Inter
    position = -730, -310
    halign = right
    valign = center
}

# Playback status
label {
    monitor = $scr2
    text = cmd[update:1000] echo "$(~/.config/hypr/bin/playerctlock.sh --status)"
    color = rgba(230, 231, 234, 1)
    font_size = 14
    font_family = Inter
    position = -740, -290
    halign = right
    valign = center
}

# Player source
label {
    monitor = $scr2
    text = cmd[update:1000] echo "$(~/.config/hypr/bin/playerctlock.sh --source)"
    color = rgba(138, 143, 152, 1)
    font_size = 10
    font_family = Inter
    position = -740, -330
    halign = right
    valign = center
}

# Album name
label {
    monitor = $scr2
    text = cmd[update:1000] echo "$(~/.config/hypr/bin/playerctlock.sh --album)"
    color = rgba(138, 143, 152, 1)
    font_size = 10
    font_family = Inter
    position = 880, -330
    halign = left
    valign = center
}

# Artist name
label {
    monitor = $scr2
    text = cmd[update:1000] echo "$(~/.config/hypr/bin/playerctlock.sh --artist)"
    color = rgba(230, 231, 234, 1)
    font_size = 10
    font_family = Inter Medium
    position = 880, -310
    halign = left
    valign = center
}

# =============================================================================
# INPUT
# =============================================================================
# graphite's edge is two lines: the field's own translucent line, and this dark
# ring one pixel outside it.
shape {
    monitor = $scr2
    size = 252, 62
    color = rgba(0, 0, 0, 0)
    rounding = 11
    border_size = 1
    border_color = rgba(0, 0, 0, 0.3)
    position = 0, -470
    halign = center
    valign = center
    zindex = 9
}

input-field {
    monitor = $scr2
    size = 250, 60
    rounding = 10
    outline_thickness = 1
    outer_color = rgba(255, 255, 255, 0.08)
    # Checking brightens the line, as focus does on windows; colour only for
    # meaning: hot for a wrong password, warm for caps lock.
    check_color = rgba(255, 255, 255, 0.5)
    fail_color = rgba(226, 113, 90, 1)
    capslock_color = rgba(229, 174, 82, 1)
    dots_size = 0.1
    dots_spacing = 1
    dots_center = true
    inner_color = rgba(21, 22, 24, 1)
    font_color = rgba(230, 231, 234, 1)
    fade_on_empty = false
    font_family = Inter
    placeholder_text = <span foreground="##8a8f98"> $USER</span>
    hide_input = false
    position = 0, -470
    halign = center
    valign = center
    zindex = 10
}

# =============================================================================
# SYSTEM INFO
# =============================================================================
label {
    monitor = $scr2
    text = cmd[update:1000] echo -e "$(~/.config/hypr/bin/infonlock.sh)"
    color = rgba(138, 143, 152, 1)
    font_size = 12
    font_family = Inter Medium
    position = -20, -510
    halign = right
    valign = center
}

# =============================================================================
# AUTH
# =============================================================================
auth {
    fingerprint {
        enabled = true
    }
}
