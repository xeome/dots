# Sway entry point. Managed by chezmoi: edit dot_config/sway/config. Outputs
# and workspaces come from .chezmoidata.toml through conf.d/settings.conf.
#
# Needs swayfx: blur, corner_radius, shadows and layer_effects are its
# extensions, not vanilla sway.

include /etc/sway/config.d/*
include conf.d/*.conf

blur enable
blur_radius 10
blur_passes 3
blur_noise 0.02
blur_saturation 1.2
blur_contrast 1.1
shadows disable
corner_radius 10

# Mirrors lua_modules/rules.lua: the xeome shell is opaque and needs no blur,
# so only the translucent zinc theme's own namespaces are blurred.
layer_effects "quickshell-zinc-bar" blur enable
# Blur behind the cards but not the transparent gaps between them.
layer_effects "quickshell-zinc-notifications" blur enable; blur_ignore_transparent enable
layer_effects "quickshell-zinc-osd" blur enable

input "type:keyboard" {
	xkb_layout  tr
	xkb_numlock enabled
	xkb_options "grp:win_space_toggle"
}

input "type:touchpad" {
	dwt enabled
	tap enabled
	middle_emulation enabled
}

# Sway ignores input blocks for devices that aren't attached, so this needs no
# per-machine flag.
input "5426:185:Razer_Razer_Basilisk_V3_X_HyperSpeed" {
	natural_scroll disabled
	accel_profile "flat"
	# With the flat profile, speed is 1 + pointer_accel: 0.24x.
	pointer_accel -0.76
}
