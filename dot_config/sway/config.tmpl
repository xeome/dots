# =============================================================================
# SWAY MAIN CONFIGURATION
# =============================================================================
# Managed by chezmoi — edit dot_config/sway/config.tmpl
#
# Device profiles come from .chezmoidata.toml, the same [machines.<hostname>]
# entries hyprland.lua.tmpl reads. Monitors, workspaces, input and the app
# commands below are all generated from there, so the two compositors can't
# drift apart the way they had.
#
# swayfx is assumed: blur, corner_radius, shadows and layer_effects are its
# extensions, not vanilla sway.
# =============================================================================
{{- $m := index .machines .chezmoi.hostname }}

include /etc/sway/config.d/*
include conf.d/*.conf

# =============================================================================
# APPEARANCE (swayfx)
# =============================================================================

blur enable
blur_radius 10
blur_passes 3
blur_noise 0.02
blur_saturation 1.2
blur_contrast 1.1
shadows disable
corner_radius 12

# Layers to blur behind. The quickshell-* namespaces replace the waybar and
# swaync entries that used to be here — both are retired; one qs process draws
# the bar, the notifications and the OSD now. Mirrors lua_modules/rules.lua.
layer_effects "quickshell-bar" blur enable
# Only the cards get a backdrop; the gaps between stacked ones are transparent.
layer_effects "quickshell-notifications" blur enable; blur_ignore_transparent enable
layer_effects "quickshell-osd" blur enable
layer_effects "vicinae" blur enable

# =============================================================================
# INPUT
# =============================================================================

input "type:keyboard" {
	xkb_layout  tr
	xkb_numlock {{ if $m.numlock }}enabled{{ else }}disabled{{ end }}
	xkb_options "grp:win_space_toggle"
}

input "type:touchpad" {
	dwt enabled
	tap enabled
	natural_scroll {{ if $m.natural_scroll }}enabled{{ else }}disabled{{ end }}
	middle_emulation enabled
}
{{ if $m.has_steelseries }}
input "4152:6190:SteelSeries_SteelSeries_Prime" {
	natural_scroll disabled
	dwt enabled
	accel_profile "flat"
	pointer_accel -0.88
}
{{ end }}
