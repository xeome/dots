# =============================================================================
# SWAY MAIN CONFIGURATION
# =============================================================================
# Managed by chezmoi — edit dot_config/sway/config.tmpl
#
# Device profiles come from .chezmoidata.toml, the same [machines.<hostname>]
# entries hyprland.lua.tmpl reads. Monitors, workspaces, input and the app
# commands below are all generated from there, so the two compositors can't
# drift apart the way they had.
#
# swayfx is assumed: blur, corner_radius, shadows and layer_effects are its
# extensions, not vanilla sway.
# =============================================================================
{{- $m := index .machines .chezmoi.hostname }}

include /etc/sway/config.d/*
include conf.d/*.conf

# =============================================================================
# APPEARANCE (swayfx)
# =============================================================================

blur enable
blur_radius 10
blur_passes 3
blur_noise 0.02
blur_saturation 1.2
blur_contrast 1.1
shadows disable
corner_radius 12

# Layers to blur behind. Mirrors lua_modules/rules.lua.
#
# The default shell (`qs -c xeome`) draws every surface opaque, so it has no
# blur rules at all — there is nothing to see through them, and its hairline
# borders work precisely because the surfaces sit at a known lightness.
#
# `qs -c zinc` is the old translucent theme, kept alongside it. It is the only
# reason blur rules still exist for quickshell, which is why it carries its own
# namespaces: shared ones would have meant blurring behind the opaque bar too,
# every frame, for nothing.
layer_effects "quickshell-zinc-bar" blur enable
# Only the cards get a backdrop; the gaps between stacked ones are transparent.
layer_effects "quickshell-zinc-notifications" blur enable; blur_ignore_transparent enable
layer_effects "quickshell-zinc-osd" blur enable
layer_effects "vicinae" blur enable

# =============================================================================
# INPUT
# =============================================================================

input "type:keyboard" {
	xkb_layout  tr
	xkb_numlock {{ if $m.numlock }}enabled{{ else }}disabled{{ end }}
	xkb_options "grp:win_space_toggle"
}

input "type:touchpad" {
	dwt enabled
	tap enabled
	natural_scroll {{ if $m.natural_scroll }}enabled{{ else }}disabled{{ end }}
	middle_emulation enabled
}

# Sway ignores input blocks for devices that aren't attached, so this needs no
# per-machine flag. Matches the device block in hyprland.lua.tmpl.
input "5426:185:Razer_Razer_Basilisk_V3_X_HyperSpeed" {
	natural_scroll disabled
	accel_profile "flat"
	pointer_accel -0.88
}
