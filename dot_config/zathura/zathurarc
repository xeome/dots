#
# The Caffeine colour scheme, same values as quickshell's Theme.qml.
#
# This used to be a committed snapshot of matugen's output, with matugen also
# generating it live from the wallpaper — two owners writing the same file. The
# [templates.zathura] entry is gone from matugen's config now that the palette
# is pinned rather than derived.

# Chrome. `default` is Theme.bar, the rest Theme.panel, so zathura's surfaces
# line up with the shell's.
set default-bg                  "#111111"
set default-fg                  "#eeeeee"
set statusbar-bg                "#191919"
set statusbar-fg                "#eeeeee"
set inputbar-bg                 "#191919"
set inputbar-fg                 "#eeeeee"
set notification-bg             "#191919"
set notification-fg             "#eeeeee"

# Caffeine's `destructive` and its ANSI yellow, both carrying primaryForeground.
set notification-error-bg       "#e54d2e"
set notification-error-fg       "#081a1b"
set notification-warning-bg     "#ffd9a0"
set notification-warning-fg     "#081a1b"

set completion-bg               "#191919"
set completion-fg               "#eeeeee"
set completion-group-bg         "#222222"
set completion-group-fg         "#b4b4b4"
set completion-highlight-bg     "#ffe0c2"
set completion-highlight-fg     "#081a1b"

set index-bg                    "#111111"
set index-fg                    "#eeeeee"
set index-active-bg             "#ffe0c2"
set index-active-fg             "#081a1b"

# Search hits. Two different colours on purpose: every match wears the accent
# and only the one you are on wears the yellow, so n/N is readable on a page
# with twenty hits. Alpha because these composite over the page itself.
set highlight-color             rgba(255,224,194,0.35)
set highlight-active-color      rgba(255,217,160,0.60)
set highlight-fg                "#081a1b"

set render-loading              true
set render-loading-bg           "#111111"
set render-loading-fg           "#eeeeee"

# Recolor mode settings — the two ends a document's black-on-white is remapped
# onto, so a PDF reads as Theme.bar / Theme.fg like everything else.
set recolor                     true
set recolor-lightcolor          "#111111"
set recolor-darkcolor           "#eeeeee"

# Custom settings
set window-title-home-tilde true
set statusbar-basename true
set selection-clipboard clipboard
set adjust-open "width"
set guioptions ""
set first-page-column 1:2
map j feedkeys "<C-Down>"
map k feedkeys "<C-Up>"
