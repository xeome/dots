#!/bin/bash
# Flips quickshell's Theme.qml light/dark and the GTK theme together, so they
# can never end up disagreeing. Bound to SUPER+T instead of a bar module — this
# is toggled rarely enough that it doesn't earn permanent space on the bar.
set -euo pipefail

# Source of truth: quickshell's persisted `light` property. If this fails
# (shell not running), stop here rather than flip GTK out of sync with it.
light=$(qs -c xeome ipc call theme toggle)

# GTK3 apps restyle on the gtk-theme switch (graphite-* theme folders); GTK4
# and libadwaita apps, ghostty included, follow color-scheme through the media
# query in ~/.config/gtk-4.0/gtk.css. Both happen live in running apps.
# foot cannot follow either, so it gets a signal: SIGUSR1 picks [colors-dark]
# from foot.ini, SIGUSR2 [colors-light]. `|| true` because no foot running is
# the normal case.
if [[ "$light" == "true" ]]; then
    mode=light
    pkill -USR2 -x foot || true
else
    mode=dark
    pkill -USR1 -x foot || true
fi
gsettings set org.gnome.desktop.interface color-scheme "prefer-$mode"
gsettings set org.gnome.desktop.interface gtk-theme "graphite-$mode"
gsettings set org.gnome.desktop.interface icon-theme "ZorinGrey-${mode^}"

# Qt takes font and icons from qt5ct/qt6ct, written from those gsettings, and
# its widgets from Kvantum. Both are read once per app: running Qt apps
# switch at their next start. Same files the modify_ scripts write.
for v in 5 6; do ~/.local/bin/qtct-conf "$v" >~/.config/qt${v}ct/qt${v}ct.conf; done
if [[ "$mode" == light ]]; then kvantum=graphite; else kvantum=graphiteDark; fi
printf '[General]\ntheme=%s\n' "$kvantum" >~/.config/Kvantum/kvantum.kvconfig

# XWayland GTK3 apps don't read gsettings: they take theme and icons from
# settings.ini when they start, so it follows too.
if [[ -f ~/.config/gtk-3.0/settings.ini ]]; then
    sed -i -E "s/^(gtk-theme-name=).*/\1graphite-$mode/; s/^(gtk-icon-theme-name=).*/\1ZorinGrey-${mode^}/" \
        ~/.config/gtk-3.0/settings.ini
fi
