#!/bin/bash
# Flips quickshell's Theme.qml light/dark, then GTK, Qt and foot to match.
# Bound to SUPER+T.
set -euo pipefail

# Quickshell's persisted `light` is the source of truth. If the shell is not
# running this fails, and set -e stops before GTK goes out of step.
light=$(qs -c xeome ipc call theme toggle)

# GTK3 follows gtk-theme and GTK4 follows color-scheme, live in running apps.
# foot follows neither: SIGUSR1 selects its [colors-dark], SIGUSR2
# [colors-light]. pkill fails when no foot is running, which is normal.
if [[ "$light" == "true" ]]; then
    mode=light
    pkill -USR2 -x foot || true
else
    mode=dark
    pkill -USR1 -x foot || true
fi
gsettings set org.gnome.desktop.interface color-scheme "prefer-$mode"
gsettings set org.gnome.desktop.interface gtk-theme "graphite-$mode"
gsettings set org.gnome.desktop.interface icon-theme "ZorinGrey-${mode^}"

# qtct-conf reads the gsettings just written, so it has to run after them. Qt
# apps read these files at start, so running ones switch on their next start.
for v in 5 6; do ~/.local/bin/qtct-conf "$v" >~/.config/qt${v}ct/qt${v}ct.conf; done
if [[ "$mode" == light ]]; then kvantum=graphite; else kvantum=graphiteDark; fi
printf '[General]\ntheme=%s\n' "$kvantum" >~/.config/Kvantum/kvantum.kvconfig

# XWayland GTK3 apps read theme and icons from settings.ini, not gsettings.
if [[ -f ~/.config/gtk-3.0/settings.ini ]]; then
    sed -i -E "s/^(gtk-theme-name=).*/\1graphite-$mode/; s/^(gtk-icon-theme-name=).*/\1ZorinGrey-${mode^}/" \
        ~/.config/gtk-3.0/settings.ini
fi
