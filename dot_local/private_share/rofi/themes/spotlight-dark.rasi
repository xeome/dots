/*******************************************************************************
 * MACOS SPOTLIGHT LIKE DARK THEME FOR ROFI
 * User                 : LR-Tech
 * Theme Repo           : https://github.com/lr-tech/rofi-themes-collection
 *******************************************************************************/

* {
    font: "Adwaita Sans 12";

    /* The Caffeine colour scheme, same values as quickshell's Theme.qml.
     * Opaque: bg0 was 65% black over the compositor blur, which made the
     * launcher's contrast a function of whatever was behind it. */
    bg0: #111111;
    bg1: #2e2e2e;
    bg2: #ffe0c2;

    fg0: #eeeeee;
    fg1: #081a1b;
    fg2: #8a8a8a;

    background-color: transparent;
    text-color: @fg0;

    margin: 0;
    padding: 0;
    spacing: 0;
}

window {
    transparency: "real";
    background-color: @bg0;
    location: center;
    width: 640;
    y-offset: 00;
    border-radius: 12;
}

inputbar {
    font: "Adwaita Sans 20";
    padding: 12px;
    spacing: 12px;
    children: [ icon-search, entry];
}

icon-search {
    expand: false;
    filename: "search";
    size: 28px;
}

icon-search,
entry,
element-icon,
element-text {
    vertical-align: 0.5;
}

entry {
    font: inherit;

    placeholder: "Search";
    placeholder-color: @fg2;
}

message {
    border: 2px 0 0;
    border-color: @bg1;
    background-color: @bg1;
}

textbox {
    padding: 8px 24px;
}

listview {
    lines: 10;
    columns: 1;

    fixed-height: false;
    border: 1px 0 0;
    border-color: @bg1;
}

element {
    padding: 8px 16px;
    spacing: 16px;
    background-color: transparent;
}

element normal active {
    text-color: @bg2;
}

element selected normal,
element selected active {
    background-color: @bg2;
    text-color: @fg1;
}

element-icon {
    size: 1em;
}

element-text {
    text-color: inherit;
}
