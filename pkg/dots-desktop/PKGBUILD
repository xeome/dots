# Everything every machine runs, whichever compositor. Built and installed by
# run_before_install-packages.sh.tmpl, which sets pkgver to this dir's content hash.
pkgname=dots-desktop
pkgver=${DOTS_PKGVER:?set by run_before_install-packages.sh}
pkgrel=1
pkgdesc='Shared desktop packages, the Qt theme environment and Keychron udev access'
arch=(any)
depends=(
    adw-gtk-theme age autotiling-rs bc bibata-cursor-theme-bin bitwarden btop
    brightnessctl chezmoi equibop evince fd fzf ghostty git-delta gnome-keyring grc
    gsettings-desktop-schemas gtk-update-icon-cache htop hyprlock inter-font jq
    kdeconnect kvantum kvantum-qt5 libnotify mate-polkit most neovim
    network-manager-applet pamixer pavucontrol playerctl python-gobject qt5ct qt6ct
    quickshell seahorse starship swayidle thunar ttf-jetbrains-mono-nerd vicinae-bin
    vim waypaper wl-clipboard xorg-xprop xorg-xwayland yazi yt-dlp zathura zellij
    zen-browser-bin zorin-icon-themes zoxide zsh zsh-completions
)

package() {
    cd "$startdir"
    install -Dm644 50-dots-qt.conf "$pkgdir/usr/lib/environment.d/50-dots-qt.conf"
    install -Dm644 dots-qt.sh "$pkgdir/etc/profile.d/dots-qt.sh"
    install -Dm644 70-dots-keychron.rules "$pkgdir/usr/lib/udev/rules.d/70-dots-keychron.rules"
}
