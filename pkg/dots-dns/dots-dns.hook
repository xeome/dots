# Applies dots-dns whenever pacman installs or changes it.
#
# Stub mode, not the uplink file: anything reading resolv.conf directly (Go,
# dig, Chrome's resolver, Docker) would otherwise skip resolved and send
# cleartext :53 straight to whatever servers are listed — no DoT, no portal hook.
#
# Restarting NM drops the link for a second; it only happens when this package
# changes. The dispatcher run re-derives every link now: resolved keeps bus-set
# link settings across a restart, so links set by an older dispatcher would
# otherwise stay stale until the next NM event.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/lib/systemd/resolved.conf.d/50-dots-dot.conf
Target = etc/NetworkManager/conf.d/50-dots-dns.conf
Target = usr/lib/NetworkManager/dispatcher.d/50-dots-portal-dns

[Action]
Description = Applying dots-dns...
When = PostTransaction
# Hooks run in an empty network namespace by default, where resolvectl cannot
# see the links the dispatcher configures.
NetworkAccess = allowed
Exec = /usr/bin/sh -c "systemctl enable --now systemd-resolved && ln -sf /run/systemd/resolve/stub-resolv.conf /etc/resolv.conf && systemctl restart systemd-resolved NetworkManager && /usr/lib/NetworkManager/dispatcher.d/50-dots-portal-dns '' up"
