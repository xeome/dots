# Applies dots-oom whenever pacman installs or changes it. systemd's own hook
# reloads the unit drop-ins; oomd.conf.d is read only at oomd's start, hence
# the restart.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = usr/lib/systemd/system/-.slice.d/50-dots-oomd.conf
Target = usr/lib/systemd/system/session-.scope.d/50-dots-oomd.conf
Target = usr/lib/systemd/system/user@.service.d/50-dots-oomd.conf
Target = usr/lib/systemd/oomd.conf.d/50-dots-oomd.conf

[Action]
Description = Applying dots-oom...
When = PostTransaction
Exec = /usr/bin/sh -c "systemctl enable systemd-oomd && systemctl restart systemd-oomd"
