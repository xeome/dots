# Re-applies TLP when dots-power-laptop or dots-power-desktop installs or
# changes the profile file. Lives here so the two profile packages carry only
# their profile. Only then, because `tlp start` drops a manually picked profile.
#
# The tmpfiles run comes after `tlp start` in the same Exec: TLP's driver mode
# switch recreates the cpufreq files at root 0644, which would take the CPU
# limit slider's write access away.
[Trigger]
Type = Path
Operation = Install
Operation = Upgrade
Target = etc/tlp.d/50-dots-profiles.conf

[Action]
Description = Applying TLP profiles...
When = PostTransaction
# Hooks run in an empty network namespace by default, where TLP cannot reach
# the wifi device for its power settings.
NetworkAccess = allowed
Exec = /usr/bin/sh -c "tlp start && systemd-tmpfiles --create dots-cpu-perf.conf"
