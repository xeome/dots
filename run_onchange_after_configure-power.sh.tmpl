#!/bin/bash
# Power profiles for the quickshell bar's battery module.
#
# Two halves behind one three-way choice:
#   - tlp-pd answers org.freedesktop.UPower.PowerProfiles, which quickshell
#     binds natively. TLP applies the profile; polkit allows an active session
#     without a password.
#   - On a hybrid Intel CPU, power-saver also pins user.slice to the E-cores
#     via `systemctl set-property --runtime`. The rule below is what stops
#     that from popping a password dialog.
#
# Plus the menu's CPU limit slider, which writes intel_pstate/max_perf_pct
# directly, or every CPU's scaling_max_freq where there is no intel_pstate.
# The tmpfiles lines below hand those files to wheel.
#
# Everything here is root-owned and outside chezmoi's $HOME scope, so the files
# are staged as the user and installed with one pkexec. chezmoi re-runs this
# whenever the rendered content changes, which includes the TLP drop-in below —
# so from now on the profile definitions are edited HERE, not in /etc.
set -euo pipefail
{{- $m := index .machines .chezmoi.hostname }}

STAGE="$(mktemp -d)"
trap 'rm -rf "$STAGE"' EXIT

cat > "$STAGE/49-ecore-pin.rules" <<'RULES'
// Let the power menu pin user.slice to the E-cores without an auth prompt.
// Scoped to set-property on user.slice alone: manage-units at large would let
// any wheel process start and stop system services unprompted.
//
// set-property still takes any property, not just AllowedCPUs. That is not
// privilege escalation, but it is a self-DoS vector: CPUQuota=1% on
// user.slice would stall your own session.
polkit.addRule(function (action, subject) {
    if (action.id == "org.freedesktop.systemd1.manage-units" &&
        action.lookup("unit") == "user.slice" &&
        action.lookup("verb") == "set-property" &&
        subject.active && subject.isInGroup("wheel")) {
        return polkit.Result.YES;
    }
});
RULES

# `z` only adjusts existing paths, so whichever line names a missing driver is
# a no-op. Boot re-applies it from /etc/tmpfiles.d before anything reads it:
# intel_pstate is built in, so the file exists by then.
#
# The scaling_max_freq files do not stay put: TLP's amd-pstate mode switch
# (guided -> active, at boot) re-registers the driver, which recreates every
# cpufreq policy at root 0644. tlp-cpu-perf.conf re-runs this after TLP starts.
#
# Like the polkit rule above, not escalation but a self-DoS vector: any wheel
# process can write 0, which the kernel clamps to min_perf_pct or
# scaling_min_freq, and nothing resets it short of the slider or a reboot.
cat > "$STAGE/cpu-perf.conf" <<'TMPFILES'
z /sys/devices/system/cpu/intel_pstate/max_perf_pct 0664 root wheel -
z /sys/devices/system/cpu/cpu*/cpufreq/scaling_max_freq 0664 root wheel -
TMPFILES

cat > "$STAGE/tlp-cpu-perf.conf" <<'DROPIN'
[Service]
ExecStartPost=/usr/bin/systemd-tmpfiles --create /etc/tmpfiles.d/cpu-perf.conf
DROPIN

{{ if $m.is_laptop -}}
cat > "$STAGE/tlp-profiles.conf" <<'TLPCONF'
# Managed by chezmoi — edit: ~/.local/share/chezmoi/run_onchange_after_configure-power.sh.tmpl
#
# In TLP 1.10 the parameter suffix IS the profile (see `man 8 tlp`):
#   performance -> *_ON_AC     balanced -> *_ON_BAT     power-saver -> *_ON_SAV
# (_ON_SAV falls back to the _ON_BAT value where it isn't set — except
# CPU_MIN/MAX_PERF, which TLP reads with no fallback.)
#
# CPU_MAX_PERF_* is deliberately unset in every profile: the bar menu's CPU
# limit slider owns intel_pstate/max_perf_pct, and with the key unset TLP
# never writes it — not on a profile switch, not on resume.
#
# TLP_PROFILE_* is pinned to BAL for both power sources on purpose. At stock
# (AC=PRF) simply plugging in would select the performance profile, so EPP
# would sit at `performance` all day with the charger in. Pinning both to
# balanced makes the bar menu the only thing that selects a profile, and — as a
# side effect of TLP_AUTO_SWITCH=2 — makes a manual pick survive plug and
# unplug, because it never matches the source default it would be replaced by.

TLP_PROFILE_AC=BAL
TLP_PROFILE_BAT=BAL

# --- performance ------------------------------------------------------------
CPU_DRIVER_OPMODE_ON_AC=active
CPU_SCALING_GOVERNOR_ON_AC=powersave
CPU_ENERGY_PERF_POLICY_ON_AC=performance
CPU_MIN_PERF_ON_AC=0
CPU_BOOST_ON_AC=1
CPU_HWP_DYN_BOOST_ON_AC=1
PLATFORM_PROFILE_ON_AC=performance
INTEL_GPU_MIN_FREQ_ON_AC=400
INTEL_GPU_MAX_FREQ_ON_AC=1500
INTEL_GPU_BOOST_FREQ_ON_AC=1500

# --- balanced (the default on both AC and battery) --------------------------
CPU_DRIVER_OPMODE_ON_BAT=active
CPU_SCALING_GOVERNOR_ON_BAT=powersave
CPU_ENERGY_PERF_POLICY_ON_BAT=balance_performance
CPU_MIN_PERF_ON_BAT=0
CPU_BOOST_ON_BAT=1
CPU_HWP_DYN_BOOST_ON_BAT=1
PLATFORM_PROFILE_ON_BAT=balanced
# The iGPU cap is a hard limit on i915 (RP0 here is 1500): measured peaking at
# exactly 1200 under load, with boost capped alongside. Power-saver inherits
# these via the _ON_SAV fallback.
INTEL_GPU_MIN_FREQ_ON_BAT=400
INTEL_GPU_MAX_FREQ_ON_BAT=1200
INTEL_GPU_BOOST_FREQ_ON_BAT=1200

# --- power-saver ------------------------------------------------------------
CPU_ENERGY_PERF_POLICY_ON_SAV=power
CPU_BOOST_ON_SAV=0
CPU_HWP_DYN_BOOST_ON_SAV=0
PLATFORM_PROFILE_ON_SAV=low-power
INTEL_GPU_POWER_PROFILE_ON_SAV=power_saving

# --- unchanged, profile-independent -----------------------------------------
WIFI_PWR_ON_BAT=off
RESTORE_DEVICE_STATE_ON_STARTUP=1
DEVICES_TO_ENABLE_ON_STARTUP="bluetooth wifi"
TLPCONF
{{- else -}}
cat > "$STAGE/tlp-profiles.conf" <<'TLPCONF'
# Managed by chezmoi — edit: ~/.local/share/chezmoi/run_onchange_after_configure-power.sh.tmpl
#
# Same profile mapping as the laptops (see `man 8 tlp`):
#   performance -> *_ON_AC     balanced -> *_ON_BAT     power-saver -> *_ON_SAV
#
# amd-pstate runs `active` here, not the `guided` the kernel cmdline boots
# into: guided has no EPP, so no profile could change what the CPU does. TLP
# switches the mode on every profile apply, before it writes EPP.
#
# No power supply is ever detected on a desktop, so TLP_PROFILE_DEFAULT is the
# profile at boot. Balanced, like the laptops; the bar menu picks the rest.

TLP_PROFILE_DEFAULT=BAL

# --- performance ------------------------------------------------------------
CPU_DRIVER_OPMODE_ON_AC=active
CPU_SCALING_GOVERNOR_ON_AC=powersave
CPU_ENERGY_PERF_POLICY_ON_AC=performance
CPU_BOOST_ON_AC=1
RADEON_DPM_PERF_LEVEL_ON_AC=auto

# --- balanced ---------------------------------------------------------------
CPU_DRIVER_OPMODE_ON_BAT=active
CPU_SCALING_GOVERNOR_ON_BAT=powersave
CPU_ENERGY_PERF_POLICY_ON_BAT=balance_performance
CPU_BOOST_ON_BAT=1
RADEON_DPM_PERF_LEVEL_ON_BAT=auto

# --- power-saver ------------------------------------------------------------
CPU_ENERGY_PERF_POLICY_ON_SAV=power
CPU_BOOST_ON_SAV=0
# RADEON_* drives amdgpu too. `low` pins both GPUs at their lowest clocks; if
# the screens flicker in power-saver, `auto` here is the fallback.
RADEON_DPM_PERF_LEVEL_ON_SAV=low

# --- unchanged, profile-independent -----------------------------------------
# Kept from the pre-chezmoi /etc/tlp.conf, where it was the one live setting
# besides the governor.
PCIE_ASPM_ON_AC=performance
PCIE_ASPM_ON_BAT=performance
TLPCONF
{{- end }}

cat > "$STAGE/install.sh" <<'INSTALL'
#!/bin/bash
set -euo pipefail
STAGE="$1"

# tlp.service is not enabled by the package on Arch, and without it nothing
# applies a profile at boot — tlp-pd alone only covers switching at runtime.
systemctl enable --now tlp.service tlp-pd.service

install -Dm644 -o root -g root "$STAGE/49-ecore-pin.rules" \
    /etc/polkit-1/rules.d/49-ecore-pin.rules

install -Dm644 -o root -g root "$STAGE/cpu-perf.conf" /etc/tmpfiles.d/cpu-perf.conf
install -Dm644 -o root -g root "$STAGE/tlp-cpu-perf.conf" \
    /etc/systemd/system/tlp.service.d/cpu-perf.conf
systemctl daemon-reload

# Retired: the menu used to switch scx_cake modes through scx_loader. cake
# dropped its -p profiles in scx-scheds 1.1.3, so it had been failing to start
# and leaving EEVDF running anyway. Undo what this script used to install.
rm -f /etc/polkit-1/rules.d/49-scx-loader.rules
if systemctl is-enabled -q scx_loader.service 2>/dev/null; then
    systemctl disable --now scx_loader.service
fi

# TLP reads /etc/tlp.conf after /etc/tlp.d, so any live line left in it beats
# the drop-in. Whatever set one (an older version of this script, or a hand
# edit) gets backed up once and replaced by the package's all-commented file.
restart=0
if grep -qvE '^\s*(#|$)' /etc/tlp.conf; then
    cp -n /etc/tlp.conf /etc/tlp.conf.pre-quickshell || true
    pkg="/var/cache/pacman/pkg/tlp-$(pacman -Q tlp | cut -d' ' -f2)-any.pkg.tar.zst"
    [ -f "$pkg" ] || pacman -Sw --noconfirm tlp
    bsdtar -xOf "$pkg" etc/tlp.conf > /etc/tlp.conf
    restart=1
fi

# Only touched when it actually differs — `tlp start` re-applies everything and
# drops manual mode, so it should not fire on every chezmoi apply.
if ! cmp -s "$STAGE/tlp-profiles.conf" /etc/tlp.d/50-profiles.conf; then
    install -Dm644 -o root -g root "$STAGE/tlp-profiles.conf" /etc/tlp.d/50-profiles.conf
    restart=1
fi
[ "$restart" = 0 ] || tlp start

# Last, so it lands after any driver mode switch `tlp start` just made.
systemd-tmpfiles --create /etc/tmpfiles.d/cpu-perf.conf
INSTALL

pkexec /usr/bin/bash "$STAGE/install.sh" "$STAGE"
