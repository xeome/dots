#!/bin/bash
# chezmoi run_onchange_ script — re-runs whenever pkgs or the machine's wm
# changes.
{{- $m := index .machines .chezmoi.hostname }}
# hash: {{ include "pkgs" | sha256sum }} wm={{ $m.wm }}

set -euo pipefail

# Detect AUR helper
if command -v yay &>/dev/null; then
    AUR=yay
elif command -v paru &>/dev/null; then
    AUR=paru
else
    AUR=pacman
fi

PKGS=(
{{ range (include "pkgs" | splitList "\n") -}}
{{- if . }}    "{{ . }}"
{{ end -}}
{{- end }})

# Compositor-specific packages, so a sway box isn't made to install hyprland
# and the hyprland boxes aren't made to install swayfx. hyprlock stays in the
# shared list — every machine locks with it.
{{- if eq $m.wm "sway" }}
PKGS+=("swayfx" "flameshot")
{{- else }}
# grimblast comes from hyprland-contrib, which isn't in any configured repo —
# install it by hand if Print stops working.
PKGS+=("hyprland" "satty")
{{- end }}

echo "Installing/updating ${#PKGS[@]} packages via $AUR..."
$AUR -S --needed --noconfirm "${PKGS[@]}"
